<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>two_dof_arm_description</name>

  <version>2.1.0</version>
  <description>5-DOF robotic arm URDF with dual-IMU motion mimicking for ROS2 RViz</description>

  <maintainer email="yadhukrishnan.ma.2005@gmail.com">dell</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool for Python-based ROS2 packages -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS2 dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Message types used by our nodes -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- TF2 for IMU debug TF broadcaster -->
  <exec_depend>tf2_ros</exec_depend>

  <!-- URDF and launch infrastructure -->
  <exec_depend>urdf</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>