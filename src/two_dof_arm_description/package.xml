<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <!--
    WHAT IS THIS FILE?
    package.xml tells ROS2 what your package is called,
    who made it, and what other packages it depends on.
    Think of it like a "requirements.txt" for your robot package.
  -->

  <!-- The name MUST match your folder name exactly -->
  <name>two_dof_arm_description</name>

  <version>1.0.0</version>
  <description>2-DOF robotic arm URDF with IMU sensors for ROS2 RViz and Gazebo</description>

  <!-- Change this to your name and email -->
  <maintainer email="yadhukrishnan.ma.2005@gmail.com">dell</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool for Python-based ROS2 packages -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- These are the ROS2 packages your project needs to run -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>