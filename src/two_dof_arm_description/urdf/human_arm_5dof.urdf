<?xml version="1.0"?>
<!--
  ============================================================
  5-DOF Robotic Arm URDF — Shoulder-mounted arm (IMPROVED)
  Project : IMU-Controlled Robotic Arm in ROS2 / RViz

  ╔══════════════════════════════════════════════════════════╗
  ║              CHANGE SUMMARY (vs original)               ║
  ╠══════════════════════════════════════════════════════════╣
  ║  KINEMATICS / JOINTS (marked *** MODIFIED ***)          ║
  ║  ─────────────────────────────────────────────────────  ║
  ║  shoulder_abduction_joint                               ║
  ║    axis  : (1 0 0) → (0 0 1)   — now Yaw  (Z)          ║
  ║    limits: -0.52→3.14 → -3.14→+3.14                    ║
  ║  shoulder_flexion_joint                                 ║
  ║    axis  : (0 1 0) unchanged   — still Pitch (Y)        ║
  ║    limits: -1.05→3.14 → -1.57→+2.62                    ║
  ║  shoulder_rotation_joint                                ║
  ║    axis  : (0 0 1) → (1 0 0)   — now Roll  (X)          ║
  ║    limits: -1.22→1.57 → -1.57→+1.57                    ║
  ║  elbow_flexion_joint                                    ║
  ║    axis  : (0 1 0) unchanged   — natural flexion        ║
  ║    limits: 0→2.53 (unchanged, already correct)         ║
  ║  forearm_rotation_joint                                 ║
  ║    axis  : (0 0 1) unchanged   — along forearm length   ║
  ║    limits: -1.57→+1.57 (unchanged, already correct)    ║
  ║                                                         ║
  ║  VISUALS (marked === VISUAL CHANGE ===)                 ║
  ║  ─────────────────────────────────────────────────────  ║
  ║  base_link      : bulkier shoulder + deltoid bumps      ║
  ║  shoulder_link_1: added small sphere (DOF indicator)   ║
  ║  shoulder_link_2: added small sphere (DOF indicator)   ║
  ║  elbow_link_1   : added prominent orange sphere        ║
  ║  upper_arm_link : capsule (2 taper sections + 2 caps)  ║
  ║                   bicep bulge (+Y), tricep ridge (−Y)  ║
  ║                   white anterior orientation strip     ║
  ║  forearm_link   : capsule (2 taper sections + 2 caps)  ║
  ║                   extensor (−Y) and flexor (+Y) ridges ║
  ║                   white anterior orientation strip     ║
  ║                   red radial-side dot (+X marker)      ║
  ║  hand_link      : slightly larger sphere + front dot   ║
  ║                                                         ║
  ║  All collision geometry kept simple (original style)   ║
  ║  All link names, lengths, hierarchy UNCHANGED           ║
  ╚══════════════════════════════════════════════════════════╝

  Rotation order (Z → Y → X) matches ZYX IMU Euler convention:
    J1  shoulder_abduction_joint  → Yaw   around Z
    J2  shoulder_flexion_joint    → Pitch around Y
    J3  shoulder_rotation_joint   → Roll  around X
    J4  elbow_flexion_joint       → Flexion around Y
    J5  forearm_rotation_joint    → Pronation/Supination around Z

  Coordinate convention (arm at rest, hanging straight down):
    +Z  upward (world vertical)
    +Y  anterior / "front of arm"  ← orientation strip is here
    +X  lateral / radial side       ← red dot is here
    −Z  direction of arm hang / forearm length axis
  ============================================================
-->

<robot name="two_dof_arm">

  <!-- ================================================================
       MATERIALS
       New: mid_grey, light_blue, dark_blue, orange,
            light_green, dark_green, white, light_skin
  ================================================================ -->
  <material name="dark_grey">
    <color rgba="0.22 0.22 0.22 1.0"/>
  </material>

  <material name="mid_grey">
    <color rgba="0.48 0.48 0.48 1.0"/>
  </material>

  <!-- Blue family — upper arm -->
  <material name="blue">
    <color rgba="0.15 0.45 0.85 1.0"/>
  </material>

  <!-- === VISUAL CHANGE: new materials for upper arm depth cues === -->
  <material name="light_blue">
    <color rgba="0.42 0.72 1.00 1.0"/>
  </material>

  <material name="dark_blue">
    <color rgba="0.05 0.14 0.50 1.0"/>
  </material>

  <!-- Green family — forearm -->
  <material name="green">
    <color rgba="0.10 0.65 0.25 1.0"/>
  </material>

  <!-- === VISUAL CHANGE: new materials for forearm depth cues === -->
  <material name="light_green">
    <color rgba="0.32 0.90 0.42 1.0"/>
  </material>

  <material name="dark_green">
    <color rgba="0.04 0.36 0.12 1.0"/>
  </material>

  <!-- Sensors / markers -->
  <material name="red">
    <color rgba="0.80 0.10 0.10 1.0"/>
  </material>

  <material name="yellow">
    <color rgba="0.90 0.80 0.00 1.0"/>
  </material>

  <!-- === VISUAL CHANGE: elbow joint colour === -->
  <material name="orange">
    <color rgba="0.92 0.52 0.08 1.0"/>
  </material>

  <!-- Skin tones — hand -->
  <material name="skin">
    <color rgba="0.87 0.72 0.53 1.0"/>
  </material>

  <material name="light_skin">
    <color rgba="0.96 0.86 0.72 1.0"/>
  </material>

  <!-- === VISUAL CHANGE: orientation-strip colour === -->
  <material name="white">
    <color rgba="0.97 0.97 0.97 1.0"/>
  </material>


  <!-- ================================================================
       WORLD + SHOULDER MOUNT
       Arm hangs DOWN from shoulder height (1.4 m)
       === VISUAL CHANGE: base_link now has deltoid-like bumps ===
  ================================================================ -->
  <link name="world"/>

  <link name="base_link">

    <!-- Primary shoulder socket sphere -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.052"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <!-- === VISUAL CHANGE: anterior deltoid bump (+Y) === -->
    <visual>
      <origin xyz="0 0.032 -0.010" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.030"/>
      </geometry>
      <material name="mid_grey"/>
    </visual>

    <!-- === VISUAL CHANGE: lateral deltoid bump (+X) === -->
    <visual>
      <origin xyz="0.028 0 -0.012" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.026"/>
      </geometry>
      <material name="mid_grey"/>
    </visual>

    <!-- === VISUAL CHANGE: posterior cap (−Y) — slightly smaller === -->
    <visual>
      <origin xyz="0 -0.026 -0.010" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="mid_grey"/>
    </visual>

    <!-- Collision: single sphere (unchanged) -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000521" ixy="0.0" ixz="0.0" iyy="0.000521" iyz="0.0" izz="0.000833"/>
    </inertial>
  </link>

  <!-- Fixed joint: world → shoulder (unchanged) -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 1.4" rpy="0 0 0"/>
  </joint>


  <!-- ================================================================
       DUMMY LINKS FOR MULTI-DOF SHOULDER
       === VISUAL CHANGE: small grey spheres added as DOF indicators ===
  ================================================================ -->
  <link name="shoulder_link_1">
    <!-- === VISUAL CHANGE: intermediate DOF indicator (Yaw→Pitch junction) === -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="mid_grey"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>

  <link name="shoulder_link_2">
    <!-- === VISUAL CHANGE: intermediate DOF indicator (Pitch→Roll junction) === -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="mid_grey"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>

  <link name="elbow_link_1">
    <!-- === VISUAL CHANGE: prominent orange elbow-joint sphere === -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.032"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>


  <!-- ================================================================
       3-DOF SHOULDER JOINTS
       *** MODIFIED: Axes reordered → Z (Yaw) → Y (Pitch) → X (Roll) ***
       This matches ZYX IMU Euler decomposition order.
  ================================================================ -->

  <!--
    *** JOINT 1 MODIFIED ***
    BEFORE: axis (1 0 0)  — abduction, limits -0.52 to +3.14
    AFTER : axis (0 0 1)  — shoulder YAW,  limits -3.14 to +3.14
    Reason: Outermost rotation in ZYX chain must be Z
  -->
  <joint name="shoulder_abduction_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!--
    *** JOINT 2 MODIFIED (axis unchanged, limits updated) ***
    BEFORE: limits -1.05 to +3.14
    AFTER : limits -1.57 to +2.62  (−90° extension → +150° forward flexion)
    Reason: Tighter anatomical pitch range for a real human shoulder
  -->
  <joint name="shoulder_flexion_joint" type="revolute">
    <parent link="shoulder_link_1"/>
    <child link="shoulder_link_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="2.6180" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!--
    *** JOINT 3 MODIFIED ***
    BEFORE: axis (0 0 1) — rotation around Z, limits -1.22 to +1.57
    AFTER : axis (1 0 0) — shoulder ROLL (internal/external rotation)
            limits -1.57 to +1.57  (±90°)
    Reason: Innermost rotation in ZYX chain must be X; Roll about the
            arm's lateral axis matches anatomical internal/external rotation
  -->
  <joint name="shoulder_rotation_joint" type="revolute">
    <parent link="shoulder_link_2"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>


  <!-- ================================================================
       UPPER ARM — hangs DOWN (−Z direction), 0.28 m long (unchanged)
       === VISUAL CHANGE: capsule-style multi-element arm with
           bicep/tricep suggestion and anterior orientation strip ===
  ================================================================ -->
  <link name="upper_arm_link">

    <!--
      VISUAL DESIGN:
        • Two stacked cylinders create a visible taper (wider near shoulder,
          narrower near elbow) — simulates natural arm shape
        • Capsule caps (spheres) at both ends for smooth termination
        • Bicep bulge offset +Y (anterior), lighter blue
        • Tricep ridge offset −Y (posterior), darker blue
        • White strip on +Y face = "front of arm" orientation cue for IMU debug
    -->

    <!-- Upper section: near shoulder — wider (r=0.028, l=0.14) -->
    <visual>
      <origin xyz="0 0 -0.070" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.140"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <!-- Lower section: near elbow — narrower (r=0.022, l=0.14) -->
    <visual>
      <origin xyz="0 0 -0.210" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.140"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <!-- Capsule cap: top (shoulder end) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.028"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <!-- Capsule cap: bottom (elbow end) -->
    <visual>
      <origin xyz="0 0 -0.280" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <!-- === VISUAL CHANGE: Bicep bulge — anterior (+Y), upper half === -->
    <visual>
      <origin xyz="0 0.011 -0.090" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.110"/>
      </geometry>
      <material name="light_blue"/>
    </visual>

    <!-- === VISUAL CHANGE: Tricep ridge — posterior (−Y), slightly longer === -->
    <visual>
      <origin xyz="0 -0.010 -0.100" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.120"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>

    <!--
      === VISUAL CHANGE: DEBUG ORIENTATION STRIPS ===
      Front (+Y): White
      Back (-Y): Dark Grey
      Outer (+X, away from body): Red
      Inner (-X, close to body): Yellow
    -->
    <!-- Front (Anterior, +Y) -->
    <visual>
      <origin xyz="0 0.030 -0.140" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.260"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- Back (Posterior, -Y) -->
    <visual>
      <origin xyz="0 -0.030 -0.140" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.260"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Outer (Lateral, +X) -->
    <visual>
      <origin xyz="0.030 0 -0.140" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.260"/>
      </geometry>
      <material name="red"/>
    </visual>
    <!-- Inner (Medial, close to body, -X) -->
    <visual>
      <origin xyz="-0.030 0 -0.140" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.260"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <!-- Collision: original simple cylinder (unchanged) -->
    <collision>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.28"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.003063" ixy="0.0" ixz="0.0" iyy="0.003063" iyz="0.0" izz="0.000125"/>
    </inertial>
  </link>


  <!-- ================================================================
       2-DOF ELBOW JOINTS
       *** MODIFIED: limits updated to anatomical ranges ***
  ================================================================ -->

  <!--
    *** JOINT 4 MODIFIED (axis unchanged) ***
    BEFORE: lower=0.0 upper=2.5307
    AFTER : lower=0.0 upper=2.5307  (already correct — retained as-is)
    Axis (0 1 0) = correct for natural elbow flexion in this frame
  -->
  <joint name="elbow_flexion_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="elbow_link_1"/>
    <origin xyz="0 0 -0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.5307" effort="8.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!--
    *** JOINT 5 MODIFIED (axis unchanged, limits tightened) ***
    Axis (0 0 1) = along forearm length (−Z hang direction → Z long-axis)
    BEFORE: lower=−1.5708 upper=+1.5708  (already correct — retained)
    Represents pronation (negative) / supination (positive)
  -->
  <joint name="forearm_rotation_joint" type="revolute">
    <parent link="elbow_link_1"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="8.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>


  <!-- ================================================================
       FOREARM — hangs DOWN (−Z direction), 0.26 m long (unchanged)
       === VISUAL CHANGE: capsule-style + muscle ridges + orientation cues ===
  ================================================================ -->
  <link name="forearm_link">

    <!--
      VISUAL DESIGN:
        • Two stacked cylinders — wider near elbow, narrower toward wrist
        • Capsule caps at both ends
        • Extensor ridge on −Y (dorsal / posterior) face
        • Flexor ridge on +Y (anterior / palmar) face
        • WHITE strip on +Y = "anterior / palm-side" orientation cue
          → When forearm_rotation_joint turns, this strip rotates too,
            making pronation/supination visually obvious in RViz
        • RED dot on +X = radial (thumb) side — distinguishes radial from ulnar
    -->

    <!-- Upper forearm (near elbow): wider (r=0.022, l=0.15) -->
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.150"/>
      </geometry>
      <material name="green"/>
    </visual>

    <!-- Lower forearm (near wrist): narrower/tapered (r=0.016, l=0.11) -->
    <visual>
      <origin xyz="0 0 -0.195" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.110"/>
      </geometry>
      <material name="green"/>
    </visual>

    <!-- Capsule cap: top (elbow end) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="green"/>
    </visual>

    <!-- Capsule cap: bottom (wrist end) -->
    <visual>
      <origin xyz="0 0 -0.260" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.016"/>
      </geometry>
      <material name="green"/>
    </visual>

    <!-- === VISUAL CHANGE: Extensor ridge — dorsal (−Y) side, upper portion === -->
    <visual>
      <origin xyz="0 -0.009 -0.080" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.100"/>
      </geometry>
      <material name="dark_green"/>
    </visual>

    <!-- === VISUAL CHANGE: Flexor (wrist/finger) ridge — palmar (+Y), upper portion === -->
    <visual>
      <origin xyz="0 0.008 -0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.095"/>
      </geometry>
      <material name="light_green"/>
    </visual>

    <!--
      === VISUAL CHANGE: DEBUG ORIENTATION STRIPS ===
      Front / Palmar (+Y): White
      Back / Dorsal (-Y): Dark Grey
      Outer / Radial (+X): Red
      Inner / Ulnar (-X): Yellow
    -->
    <!-- Front (+Y) -->
    <visual>
      <origin xyz="0 0.024 -0.130" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.240"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- Back (-Y) -->
    <visual>
      <origin xyz="0 -0.024 -0.130" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.240"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Outer (+X) -->
    <visual>
      <origin xyz="0.024 0 -0.130" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.240"/>
      </geometry>
      <material name="red"/>
    </visual>
    <!-- Inner (-X) -->
    <visual>
      <origin xyz="-0.024 0 -0.130" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.004 0.240"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <!-- Collision: original simple cylinder (unchanged) -->
    <collision>
      <origin xyz="0 0 -0.13" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.26"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.13" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.001344" ixy="0.0" ixz="0.0" iyy="0.001344" iyz="0.0" izz="0.000050"/>
    </inertial>
  </link>


  <!-- ================================================================
       HAND — palm and thumb/fingers structure at end of forearm
       === VISUAL CHANGE: human hand look without wrist joint ===
  ================================================================ -->
  <link name="hand_link">

    <!-- Inner Palm (Palmar surface, +Y) -->
    <visual>
      <origin xyz="0 0.015 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.01 0.10"/>
      </geometry>
      <material name="white"/>
    </visual>

    <!-- Outer Palm (Dorsal surface, -Y) -->
    <visual>
      <origin xyz="0 -0.005 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.10"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <!-- Inner Fingers (Palmar side, +Y) -->
    <visual>
      <origin xyz="0 0.010 -0.14" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.01 0.08"/>
      </geometry>
      <material name="white"/>
    </visual>

    <!-- Outer Fingers (Dorsal side, -Y) -->
    <visual>
      <origin xyz="0 -0.005 -0.14" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.01 0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <!-- Thumb (Radial side, +X) -->
    <visual>
      <origin xyz="0.045 0.01 -0.05" rpy="0 -0.3 0"/>
      <geometry>
        <box size="0.03 0.025 0.07"/>
      </geometry>
      <material name="red"/>
    </visual>

    <!-- Collision: bounding box for hand -->
    <collision>
      <origin xyz="0 0.005 -0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.04 0.18"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.005 -0.09" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Fixed: forearm → hand (unchanged) -->
  <joint name="forearm_to_hand" type="fixed">
    <parent link="forearm_link"/>
    <child link="hand_link"/>
    <origin xyz="0 0 -0.26" rpy="0 0 0"/>
  </joint>


  <!-- ================================================================
       IMU SENSOR 1 — UPPER ARM (Blue)
       Placed firmly on the outer side (deltoid/bicep), slightly below shoulder
  ================================================================ -->
  <joint name="imu_shoulder_joint" type="fixed">
    <parent link="upper_arm_link"/>
    <child link="imu_shoulder_link"/>
    <!-- Positioned on outer part (+X), 6cm below shoulder (-Z) -->
    <origin xyz="0.033 0 -0.06" rpy="0 -0.1 0"/>
  </joint>

  <link name="imu_shoulder_link">
    <!-- IMU Casing (Blue) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.025 0.035"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>
    <!-- Strap (Dark Grey) -->
    <visual>
      <origin xyz="-0.033 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.030" length="0.012"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.025 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>


  <!-- ================================================================
       IMU SENSOR 2 — FOREARM (Green)
       Placed on top side of forearm (dorsal), couple cm above wrist, watch style
  ================================================================ -->
  <joint name="imu_elbow_joint" type="fixed">
    <parent link="forearm_link"/>
    <child link="imu_elbow_link"/>
    <!-- Positioned on dorsal side (-Y), 21cm down from elbow (~5cm above wrist) -->
    <origin xyz="0 -0.019 -0.21" rpy="0.1 0 0"/>
  </joint>

  <link name="imu_elbow_link">
    <!-- IMU Casing (Green) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.012 0.035"/>
      </geometry>
      <material name="dark_green"/>
    </visual>
    <!-- Strap (Dark Grey) -->
    <visual>
      <origin xyz="0 0.019 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.012"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.012 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>


  <!-- ================================================================
       GAZEBO MATERIALS (unchanged + added elbow)
  ================================================================ -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="upper_arm_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="forearm_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <gazebo reference="elbow_link_1">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="imu_shoulder_link">
    <material>Gazebo/Red</material>
  </gazebo>
  <gazebo reference="imu_elbow_link">
    <material>Gazebo/Yellow</material>
  </gazebo>


  <!-- ================================================================
       GAZEBO IMU PLUGINS (UNCHANGED)
  ================================================================ -->
  <gazebo reference="imu_shoulder_link">
    <sensor name="imu_shoulder_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>/imu_shoulder/data</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_shoulder_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/imu_shoulder/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_shoulder_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_elbow_link">
    <sensor name="imu_elbow_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>/imu_elbow/data</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_elbow_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/imu_elbow/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_elbow_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find two_dof_arm_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>