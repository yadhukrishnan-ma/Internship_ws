<?xml version="1.0"?>
<!--
  ============================================================
  2-DOF Robotic Arm URDF
  Project : IMU-Controlled Robotic Arm in ROS2 / RViz / Gazebo
  Author  : Generated for ROS2 Robotics Project
  Links   : base_link → upper_arm_link → forearm_link
  Joints  : shoulder_joint (revolute), elbow_joint (revolute)
  IMUs    : imu_shoulder_link (on upper_arm_link)
            imu_elbow_link    (on forearm_link)
  ============================================================
-->

<robot name="two_dof_arm">

  <!-- ================================================================
       MATERIALS
       Define reusable color materials for visual clarity in RViz.
  ================================================================ -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.4 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.1 0.7 0.2 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <material name="yellow">
    <color rgba="0.9 0.8 0.0 1.0"/>
  </material>


  <!-- ================================================================
       LINK 1 : base_link
       The fixed base of the robot — represents the shoulder mount.
       This link is anchored to the world in RViz and Gazebo.

       Dimensions : 0.10 m × 0.10 m × 0.05 m box (a flat mounting plate)
       Origin     : Centered at world origin (0, 0, 0)
  ================================================================ -->
  <link name="base_link">

    <visual>
      <origin xyz="0.0 0.0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Mass : 0.5 kg (mounting plate + motor housing) -->
      <origin xyz="0.0 0.0 0.025" rpy="0 0 0"/>
      <mass value="0.5"/>
      <!--
        Inertia tensor for a solid box:
          Ixx = (1/12) * m * (y² + z²)
          Iyy = (1/12) * m * (x² + z²)
          Izz = (1/12) * m * (x² + y²)
        With m=0.5, x=0.10, y=0.10, z=0.05:
          Ixx = (1/12)*0.5*(0.01+0.0025) = 0.000521
          Iyy = (1/12)*0.5*(0.01+0.0025) = 0.000521
          Izz = (1/12)*0.5*(0.01+0.01)   = 0.000833
      -->
      <inertia ixx="0.000521" ixy="0.0" ixz="0.0"
               iyy="0.000521" iyz="0.0"
               izz="0.000833"/>
    </inertial>

  </link>


  <!-- ================================================================
       DUMMY LINKS FOR MULTI-DOF JOINTS
       ================================================================ -->
  <link name="shoulder_link_1">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>

  <link name="shoulder_link_2">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>

  <link name="elbow_link_1">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- ================================================================
       3-DOF SHOULDER JOINTS
       ================================================================ -->
  <joint name="shoulder_abduction_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="shoulder_link_1"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5236" upper="3.1416" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="shoulder_flexion_joint" type="revolute">
    <parent link="shoulder_link_1"/>
    <child  link="shoulder_link_2"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0472" upper="3.1416" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="shoulder_rotation_joint" type="revolute">
    <parent link="shoulder_link_2"/>
    <child  link="upper_arm_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2217" upper="1.5708" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>


  <!-- ================================================================
       LINK 2 : upper_arm_link
       Represents the human upper arm (shoulder to elbow).
       Length  : 0.30 m
       Shape   : Cylinder, radius = 0.025 m

       IMPORTANT ORIGIN NOTE:
       The link origin (0,0,0) is at the shoulder joint.
       The geometry is offset by +0.15 m in Z so the cylinder
       extends from z=0 (joint) to z=0.30 m (elbow end).
       This is the correct ROS convention for serial link robots.
  ================================================================ -->
  <link name="upper_arm_link">

    <visual>
      <!-- Offset geometry so it starts at joint and extends upward -->
      <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.30"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.30"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Mass : 0.4 kg (upper arm segment + motor for elbow) -->
      <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
      <mass value="0.4"/>
      <!--
        Inertia tensor for a solid cylinder about its center:
          Ixx = Iyy = (1/12)*m*(3r² + h²)
          Izz = (1/2)*m*r²
        With m=0.4, r=0.025, h=0.30:
          Ixx = (1/12)*0.4*(0.001875 + 0.09) = 0.003063
          Iyy = 0.003063
          Izz = (1/2)*0.4*(0.000625) = 0.000125
      -->
      <inertia ixx="0.003063" ixy="0.0" ixz="0.0"
               iyy="0.003063" iyz="0.0"
               izz="0.000125"/>
    </inertial>

  </link>


  <!-- ================================================================
       2-DOF ELBOW JOINTS
       ================================================================ -->
  <joint name="elbow_flexion_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child  link="elbow_link_1"/>
    <origin xyz="0.0 0.0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.5307" effort="8.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <joint name="forearm_rotation_joint" type="revolute">
    <parent link="elbow_link_1"/>
    <child  link="forearm_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="8.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>


  <!-- ================================================================
       LINK 3 : forearm_link
       Represents the human forearm (elbow to wrist).
       Length  : 0.25 m
       Shape   : Cylinder, radius = 0.020 m  (slightly thinner than upper arm)

       Same origin offset convention: geometry starts at z=0 (elbow joint)
       and extends to z=0.25 m.
  ================================================================ -->
  <link name="forearm_link">

    <visual>
      <origin xyz="0.0 0.0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.25"/>
      </geometry>
      <material name="green"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.25"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Mass : 0.25 kg (forearm segment) -->
      <origin xyz="0.0 0.0 0.125" rpy="0 0 0"/>
      <mass value="0.25"/>
      <!--
        With m=0.25, r=0.020, h=0.25:
          Ixx = (1/12)*0.25*(0.0012 + 0.0625) = 0.001344
          Iyy = 0.001344
          Izz = (1/2)*0.25*(0.0004) = 0.00005
      -->
      <inertia ixx="0.001344" ixy="0.0" ixz="0.0"
               iyy="0.001344" iyz="0.0"
               izz="0.000050"/>
    </inertial>

  </link>


  <!-- ================================================================
       IMU SENSOR 1 : imu_shoulder_link
       Attached to : upper_arm_link  (via fixed joint)
       Placement   : Near the shoulder end of upper arm (z = 0.04 m)
                     Mounted slightly offset in Y to avoid the joint axis.

       WHY NOT ON THE JOINT?
       Joints in URDF are mathematical points — they have no physical body.
       IMU sensors must be on a physical rigid body (link) to measure
       real acceleration and angular velocity. Placing an IMU on a link
       that is near but NOT on the joint axis gives meaningful readings.

       Shape : Small box 0.03 × 0.02 × 0.01 m (PCB board size)
  ================================================================ -->

  <!-- Fixed joint attaching IMU to upper_arm_link -->
  <joint name="imu_shoulder_joint" type="fixed">
    <parent link="upper_arm_link"/>
    <child  link="imu_shoulder_link"/>
    <!--
      Offset from upper_arm_link origin:
        z = 0.04  → near the shoulder end of the upper arm
        y = 0.035 → offset sideways from the cylindrical arm body
    -->
    <origin xyz="0.0 0.035 0.04" rpy="0 0 0"/>
  </joint>

  <link name="imu_shoulder_link">

    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <!-- IMU chip is very light: ~5 grams -->
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <!--
        For a tiny box: Ixx = Iyy = Izz ≈ negligible
        Using minimum safe inertia values for Gazebo stability.
      -->
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0"
               iyy="1e-6" iyz="0.0"
               izz="1e-6"/>
    </inertial>

  </link>


  <!-- ================================================================
       IMU SENSOR 2 : imu_elbow_link
       Attached to : forearm_link  (via fixed joint)
       Placement   : Near the elbow end of forearm (z = 0.03 m)
                     Mounted slightly offset in Y.
  ================================================================ -->

  <!-- Fixed joint attaching IMU to forearm_link -->
  <joint name="imu_elbow_joint" type="fixed">
    <parent link="forearm_link"/>
    <child  link="imu_elbow_link"/>
    <!--
      Offset from forearm_link origin:
        z = 0.03  → near the elbow end of the forearm
        y = 0.030 → offset sideways from the cylindrical forearm body
    -->
    <origin xyz="0.0 0.030 0.03" rpy="0 0 0"/>
  </joint>

  <link name="imu_elbow_link">

    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.01"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0"
               iyy="1e-6" iyz="0.0"
               izz="1e-6"/>
    </inertial>

  </link>


  <!-- ================================================================
       GAZEBO PLUGINS AND SIMULATION PROPERTIES
       These tags are Gazebo-specific and are ignored by RViz.
       They configure physics and sensor simulation.
  ================================================================ -->

  <!-- Gazebo material for base_link -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Gazebo material for upper_arm_link -->
  <gazebo reference="upper_arm_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Gazebo material for forearm_link -->
  <gazebo reference="forearm_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <!-- Gazebo material for IMU links -->
  <gazebo reference="imu_shoulder_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="imu_elbow_link">
    <material>Gazebo/Yellow</material>
  </gazebo>


  <!-- ================================================================
       GAZEBO IMU PLUGIN — Shoulder IMU
       This plugin simulates a real IMU sensor on imu_shoulder_link.
       It publishes sensor_msgs/Imu messages to the ROS2 topic:
           /imu_shoulder/data

       Parameters:
         - updateRate   : 100 Hz  (100 readings per second)
         - gaussianNoise: Small noise to simulate real sensor imperfection
         - topicName    : ROS2 topic for publishing IMU data
         - frameName    : TF frame the data is reported in
  ================================================================ -->
  <gazebo reference="imu_shoulder_link">
    <sensor name="imu_shoulder_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>/imu_shoulder/data</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_shoulder_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/imu_shoulder/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_shoulder_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>


  <!-- ================================================================
       GAZEBO IMU PLUGIN — Elbow IMU
       Publishes to: /imu_elbow/data
  ================================================================ -->
  <gazebo reference="imu_elbow_link">
    <sensor name="imu_elbow_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>/imu_elbow/data</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_elbow_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/imu_elbow/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_elbow_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!--
    ================================================================
    GAZEBO JOINT CONTROL PLUGIN (ros2_control interface)
    Allows external joint state commands via ROS2 topics.
    The joint_state_broadcaster publishes /joint_states.
    The joint_trajectory_controller accepts angle commands.
    ================================================================
  -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find two_dof_arm_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
